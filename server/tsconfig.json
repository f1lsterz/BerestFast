{
  "compilerOptions": {
    "strict": false,
    "esModuleInterop": true,
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@auth/*": ["src/auth/*"],
      "@chat/*": ["src/chat/*"],
      "@common/*": ["src/common/*"],
      "@cache/*": ["src/common/cache/*"],
      "@decorators/*": ["src/common/decorators/*"],
      "@errors/*": ["src/common/errors/*"],
      "@filters/*": ["src/common/filters/*"],
      "@guards/*": ["src/common/guards/*"],
      "@pipes/*": ["src/common/pipes/*"],
      "@strategies/*": ["src/common/strategies/*"],
      "@resTypes/*": ["src/common/types/*"],
      "@config/*": ["src/config/*"],
      "@order/*": ["src/order/*"],
      "@payment/*": ["src/payment/*"],
      "@product/*": ["src/product/*"],
      "@user/*": ["src/user/*"]
    },
    "incremental": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}

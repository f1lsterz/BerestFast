model User {
  id              Int                  @id @default(autoincrement())
  phoneNumber     String               @unique @db.VarChar(20)
  name            String               @db.VarChar(100)
  password        String
  photoUrl        String?              @db.VarChar(500)
  role            Role                 @default(USER)

  restaurantPartners RestaurantPartner[]
  chatParticipants   ChatParticipant[]
  messages           Message[]
  sessions           Session[]
  orders             Order[]             @relation("UserOrders")
  deliveries         Order[]             @relation("CourierOrders")
  favouriteProducts  FavouriteProduct[]
  userAddresses      Users_Addresses[]
  payments           Payment[]
  reviews            OrderReview[]

  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt      @map("updated_at")
}

model Session {
  id           Int       @id @default(autoincrement())
  refreshToken String    @db.VarChar(500)
  deviceName   String    @db.VarChar(100)
  os           String    @db.VarChar(100)
  appVersion   String    @db.VarChar(50)
  ipAddress    String?   @db.VarChar(45)

  userId       Int       @map("user_id")
  user         User      @relation(fields: [userId], references: [id])

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt      @map("updated_at")

  @@unique([userId, refreshToken])
}

enum Role {
  USER
  ADMIN
  COURIER
  PARTNER
}
model Order {
    id Int @id @default(autoincrement())
    status Order_Status @default(PENDING)
    totalAmount    Decimal   @db.Decimal(10,2)  @default(0)

    userId      Int           @map("user_id")
    courierId   Int           @map("courier_id")

    chat        Chat?
    payment     Payment?
    review      OrderReview?

    user        User          @relation("UserOrders",    fields: [userId],    references: [id])
    courier     User          @relation("CourierOrders", fields: [courierId], references: [id])
    parts       OrderPart[]

    createdAt   DateTime      @default(now()) @map("created_at")
    updatedAt   DateTime      @updatedAt      @map("updated_at")
    completedAt DateTime?     @map("completed_at")

    @@index([userId])
    @@index([courierId])
    @@map("orders")
}

model OrderPart {
  id           Int           @id @default(autoincrement())
  status       Order_Status  @default(PENDING)
  amount       Decimal       @db.Decimal(10, 2)

  orderId      Int           @map("order_id")
  storeId      Int?          @map("store_id")
  restaurantId Int?          @map("restaurant_id")

  order        Order         @relation(fields: [orderId],       references: [id])
  store        Store?        @relation(fields: [storeId],       references: [id])
  restaurant   Restaurant?   @relation(fields: [restaurantId], references: [id])

  items        OrderItems[]

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt      @map("updated_at")

  @@index([orderId])
  @@index([storeId])
  @@index([restaurantId])
  @@map("order_parts")
}

model OrderItems {
  id           Int         @id @default(autoincrement())
  quantity     Int

  orderPartId  Int         @map("order_part_id")
  productId    Int         @map("product_id")

  orderPart    OrderPart   @relation(fields: [orderPartId], references: [id])
  product      Product     @relation(fields: [productId],   references: [id])

  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt      @map("updated_at")

  @@index([orderPartId])
  @@index([productId])
  @@map("order_items")
}

model OrderReview {
  id           Int       @id @default(autoincrement())
  rating       Int
  comment      String?

  orderId      Int       @unique @map("order_id")
  userId       Int       @map("user_id")

  order        Order     @relation(fields: [orderId], references: [id])
  user         User      @relation(fields: [userId],  references: [id])

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt      @map("updated_at")

  @@index([orderId])
  @@index([userId])
  @@map("order_reviews")
}

enum Order_Status {
    PENDING
    ACCEPTED
    DELIVERED
    CANCELLED
}